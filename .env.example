# ---------------------------------------------------------------------------
# Cymbal Operations Agent - environment template
# Copy to `.env` and fill in the values for YOUR project. Nothing in the source
# tree hardcodes a project id: every value below is resolved at runtime by
# `app/config.py`, and PROJECT_ID itself falls back to the project bound to your
# Application Default Credentials when omitted.
# ---------------------------------------------------------------------------

# --- Required: target GCP environment -------------------------------------
PROJECT_ID=<PROJECT_ID>
REGION=us-central1

# --- BigQuery Conversational Data Agent (Text-to-SQL) ---------------------
# Either set DATA_AGENT_NAME explicitly, or set DATA_AGENT_ID and let the path
# be composed as projects/<PROJECT_ID>/locations/<DATA_AGENT_LOCATION>/dataAgents/<DATA_AGENT_ID>
DATA_AGENT_ID=cymbal-retail-analytics-data-agent
DATA_AGENT_LOCATION=global
# DATA_AGENT_NAME=projects/<PROJECT_ID>/locations/global/dataAgents/cymbal-retail-analytics-data-agent

# --- RAG (BigQuery vector search) -----------------------------------------
BQ_GOLD_DATASET=cymbal_gold
BQ_CHUNK_EMBEDDINGS_TABLE_ID=pos_manual_chunk_embeddings
EMBEDDING_ENDPOINT=text-embedding-005
RAG_SIMILARITY_THRESHOLD=0.70

# --- Bigtable + MCP microservice ------------------------------------------
BIGTABLE_INSTANCE_ID=operations-db
BIGTABLE_TABLE_ID=cashier_realtime_alerts
# Cloud Run URL printed by `make mcp-deploy`
BIGTABLE_MCP_URL=https://mcp-toolbox-bigtable-<HASH>-uc.a.run.app
BIGTABLE_MCP_TOOLSET=cymbal_operations
# Set to true to fail fast instead of degrading to the direct Bigtable client
BIGTABLE_MCP_REQUIRED=false

# --- Gemini / Vertex AI ----------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=<PROJECT_ID>
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.6-flash

# --- Telemetry: BigQuery Agent Analytics ----------------------------------
# Dataset/table receiving the ADK BigQueryAgentAnalyticsPlugin event stream.
# The plugin auto-creates the table and the v_* analysis views on first write.
BQ_TELEMETRY_DATASET=agent_telemetry
BQ_TELEMETRY_TABLE=events
# BigQuery location of the telemetry dataset (defaults to REGION).
BQ_TELEMETRY_LOCATION=us-central1
# Set to false to run the agent without streaming telemetry.
ENABLE_BQ_TELEMETRY=true
