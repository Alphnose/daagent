Running a query
SELECT session_id,
       tool_name,
       error_message,
       status, timestamp
FROM
  (-- Failed tool calls
 SELECT session_id,
        tool_name,
        error_message,
        status, timestamp
   FROM `antigravity-503007.agent_telemetry.v_tool_error`
   UNION ALL -- Sessions / Invocations / Agent level errors
 SELECT session_id,
        CAST(NULL AS STRING) AS tool_name,
        error_message,
        status, timestamp
   FROM `antigravity-503007.agent_telemetry.v_agent_error`
   UNION ALL SELECT session_id,
                    CAST(NULL AS STRING) AS tool_name,
                    error_message,
                    status, timestamp
   FROM `antigravity-503007.agent_telemetry.v_invocation_error`
   UNION ALL -- Events with error status or populated error message across all lifecycle events
 SELECT session_id,
        CAST(NULL AS STRING) AS tool_name,
        error_message,
        status, timestamp
   FROM `antigravity-503007.agent_telemetry.events`
   WHERE status = 'ERROR'
     OR (error_message IS NOT NULL
         AND TRIM(error_message) != '') ) QUALIFY ROW_NUMBER() OVER(PARTITION BY session_id, tool_name, error_message, timestamp
                                                                    ORDER BY timestamp) = 1
ORDER BY timestamp DESC
Query execution completed
Query returned 2 rows in 1.28s.
I checked across all tool error views (`v_tool_error`), session/invocation/agent error views (`v_agent_error`, `v_invocation_error`), and general telemetry events for any recorded errors or failed tool executions.
