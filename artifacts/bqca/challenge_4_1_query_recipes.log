          error_message,
          status, timestamp
     FROM `antigravity-503007.agent_telemetry.v_agent_error`
     UNION ALL SELECT session_id,
                      CAST(NULL AS STRING) AS tool_name,
                      error_message,
                      status, timestamp
     FROM `antigravity-503007.agent_telemetry.v_invocation_error`
     UNION ALL -- Events with error status or populated error message across all lifecycle events
   SELECT session_id,
